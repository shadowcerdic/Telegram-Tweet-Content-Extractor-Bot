# Required
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional (defaults shown)
POLL_INTERVAL=1
LOG_LEVEL=INFO

# Tweet translation target (FxTwitter language code). Leave empty to disable.
TRANSLATE_TO=fa

# Second translation layer when FxTwitter's translate backend returns nothing for
# this tweet/language pair: google | off
TRANSLATE_FALLBACK=google

# Reply again when a user edits a message containing a link (default: off)
PROCESS_EDITED_MESSAGES=0

# Instagram: a logged-in session greatly improves reliability on servers/VPS.
# Create the session once with:  instaloader --login YOUR_USERNAME
INSTAGRAM_USERNAME=
INSTAGRAM_SESSION_FILE=
